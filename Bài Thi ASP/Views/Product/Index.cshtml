@using StageSeven.Models
@model IEnumerable<Product>
@{
	ViewBag.Title = "Product Index";
}
@* Của MVC
<form asp-controller="Product" asp-action="Search" method="get">
	<label for="search">Search: </label>
	<input type="text" id="search" name="search"/>
	<button type="submit">Search</button>
</form> *@
<hr />

@*Tìm kiếm của ajax*@
<form asp-controller="Product" asp-action="Search" method="get">
	<label for="search">Search: </label>
	<input type="text" id="find" name="search" list="autocomplete-list" data-url="@Url.RouteUrl("AutoComplete")?term=__Name__" placeholder="Search something...." autocomplete="off" value="@ViewBag.Seat"/>
	<datalist id="autocomplete-list">
		@foreach (var item in Model)
		{
			<option value="@item.Name"></option>
		}
	</datalist>
	<button type="submit">Search</button>
</form>
<h1>Đây là View của Product Controller</h1>
<div class="container">
	<h2>Danh sách sản phảm</h2>
	<div class="table-responsive">
		<table class="table table-hover table-bordered table-striped">
			<thead class="table-dark">
				<tr>
					<th>ID</th>
					<th>Name</th>
					<th>photo</th>
					<th>Status</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var item in Model)
				{
					<partial name="PartialViews/Product/_ProductTableRow" model="item" />
				}
			</tbody>
		</table>
	</div>
</div>
@section Scripts{
	<script type="module" src="~/js/product/auto-complete.js"></script>
}
