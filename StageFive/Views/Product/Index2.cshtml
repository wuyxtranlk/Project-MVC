@using StageFive.Models

@model Product

<table class="border">
	<thead>
		<tr>
			<th>Id</th>
			<th>Name</th>
			<th>Photo</th>
			<th>Mfg</th>
			<th>Status</th>
			<th>Price</th>
			<th>Quantity</th>
		</tr>
	</thead>
	<tbody>
		<tr>
			<td>@Model.Id</td>
			<td>@Model.Name</td>
			<td><img src="~/img/@Model.Photo" alt="" width="50" /> </td>
			<td>@(Model.Mfg.ToString("yyyy/MM/dd"))</td>
			<td>@(Model.Status ? "Valuable" : "N/A")</td>
			<td>@Model.Price</td>
			<td>@Model.Quantity</td>
			<td>@(Model.Price* Model.Quantity)</td>
		</tr>
	</tbody>
</table>