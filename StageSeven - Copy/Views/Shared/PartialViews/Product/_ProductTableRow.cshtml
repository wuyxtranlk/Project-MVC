@using StageSeven.Models
@model Product
<tr>
	<td>@Model.Id</td>
	<td>@Model.Name</td>
	<td><img src="~/img/@Model.Photo" /></td>
	<td>@Model.StatusDisplay</td>
	<td>
		<a asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id">Xem chi tiết</a> |
		<a asp-controller="Product" asp-action="Edit" asp-route-id="@Model.Id">Chỉnh sửa</a> |
		<a asp-controller="Product" asp-action="Delete" asp-route-id="@Model.Id">Xóa</a>
	</td>
</tr>