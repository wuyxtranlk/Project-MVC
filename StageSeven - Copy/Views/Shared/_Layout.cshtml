<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="~/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
	<script src="~/js/shared/site.js" defer></script>
	@RenderSection("ExtraCss", required: false)
    <title>@ViewBag.Title</title>
</head>
<body>
    <div class="container">
		<div class="row">
			<partial name="PartialViews/_Header" />
        </div>
		<div class="row">
			<partial name="PartialViews/_Left"/>
			<div class="col-md-9">
				@RenderBody()
			</div>
        </div>
		<div class="row">
			<partial name="PartialViews/_Footer" />
        </div>
    </div>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
