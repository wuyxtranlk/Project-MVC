@using StageSeven.Models
@model Account
<link href="~/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
<script src="~/bootstrap/js/bootstrap.min.js"></script>
@if (TempData["SuccessMessage"] is not null)
{
	<div class="alert alert-success">
		@TempData["SuccessMessage"]
	</div>
}
@if (User?.Identity?.IsAuthenticated == true)
{
	<div>Welcome back! <b>@User.Identity.Name</b>!</div>
	@if(User.IsInRole("Admin")) {
		<div>
			<a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin Dashboard</a>
		</div>
	}
	<div>
		<form method="post" asp-controller="Account" asp-action="Logout">
			<button type="submit">Logout</button>
		</form>
	</div>
} else 
{

	<div class="container">
		<form method="post" asp-controller="Account" asp-action="login">
			<fieldset class="position-fixed">
				<legend>Login</legend>
				<div class="form-group">
					<label asp-for="Username">Username</label>
					<input asp-for="Username" class="form-control" placeholder="Enter your username..."/>
				</div>
				<div>
					<label asp-for="Password">Password</label>
					<input asp-for="Password" class="form-control" type="password" placeholder="Enter your password..." id="pwd"/>
					<input type="checkbox" onclick="pwd.type = this.checked ? 'text' : 'password'" /> Show Password
				</div>
				<br />
				<button type="submit" class="btn btn-primary">Login</button>
		</form>
			@if (ViewBag.ErrorMessage is not null)
			{
				<div class="alert alert-danger">
					@ViewBag.ErrorMessage
				</div>
			}
		<a asp-controller="Account" asp-action="Register">Bạn chưa có tài khoản? Vui lòng click vào đây để đăng kí</a>
	</div>
}