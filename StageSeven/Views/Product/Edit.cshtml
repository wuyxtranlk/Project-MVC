@using StageSeven.Models
@model Product
@{
	ViewBag.Title = "Product Details";
}
<div class="container">
	<h2>Chỉnh sửa sản phẩm</h2>
	<div class="table-responsive">
		<table class="table table-hover table-bordered table-striped">
			<thead class="table-dark">
				<tr>
					<th>ID</th>
					<th>Name</th>
					<th>Photo</th>
					<th>Mfg</th>
					<th>Quantity</th>
					<th>Price</th>
					<th>Status</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<td>@Model.Id</td>
					<td><input type="text" value="@Model.Name"/></td>
					<td><img src="~/img/@Model.Photo" alt="Photo" width="50" /></td>
					<td><input type="text" value="@Model.Mfg.ToString("dd/MM/yyyy")"/></td>
					<td><input type="text" value="@Model.Quantity"/></td>
					<td><input type="text" value="@Model.Price"/></td>
					<td>@(Model.Status ? "Active" : "InActive")</td>
				</tr>
				<tr>
					<td colspan="7">
						<button type="submit" asp-controller="Product" asp-action="Edit">Save</button>
					</td>
				</tr>
			</tbody>
		</table>
	</div>
	<a asp-controller="Product" asp-action="Index">Back to san-pham</a>
</div>

