@model Account

@if (TempData["SuccessMessage"] is not null)
{
	<div class="alert alert-success">
		@TempData["SuccessMessage"]
	</div>
}

@if (TempData["ErrorMessage"] is not null)
{
	<div class="alert alert-danger">
		@TempData["ErrorMessage"]
	</div>
}
<link href="~/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
<script src="~/bootstrap/js/bootstrap.min.js"></script>
<div class="container">
	<form method="post" asp-controller="Account" asp-action="Register">
		<fieldset class="position-fixed">
			<legend>Register</legend>
			<div class="form-group">
				<label asp-for="Username">Username</label>
				<input asp-for="Username" class="form-control" placeholder="Enter your username..." />
			</div>
			<div class="form-group>
				<label asp-for="Password">Password</label>
				<input asp-for="Password" class="form-control" type="password" placeholder="Enter your password..." id="pwd"/>
				<input type="checkbox" onclick="pwd.type = this.checked ? 'text' : 'password'" /> Show Password
			</div>
			<br />
			<button type="submit" class="btn btn-primary">Register</button>
	</form>

	@if (ViewBag.ErrorMessage is not null)
	{
		<div class="alert alert-danger">
			@ViewBag.ErrorMessage
		</div>
	}
	<a asp-controller="Account" asp-action="Login">Bạn đã có tài khoản? Vui lòng click vào đây để đăng nhập</a>
</div>