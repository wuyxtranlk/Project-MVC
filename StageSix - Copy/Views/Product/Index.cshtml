@model IEnumerable<Product>
<link href="~/bootstrap/css/bootstrap.min.css" rel="stylesheet"/>

<form asp-controller="Product" asp-action="Search" method="get">
	<label for="search">Search: </label>
	<input type="text" id="search" name="search"/>
	<button type="submit">Search</button>
</form>
<hr />
<h1>Đây là View của Product Controller</h1>
<div class="container">
	<h2>Danh sách sản phảm</h2>
	<div class="table-responsive">
		<table class="table table-hover table-bordered table-striped">
			<thead class="table-dark">
				<tr>
					<th>ID</th>
					<th>Name</th>
					<th>photo</th>
					<th>Status</th>
					<th>Details</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var item in Model)
				{
					<tr>
						<td>@item.Id</td>
						<td>@item.Name</td>
						<td><img src="~/img/@item.Photo"/></td>
						<td>@item.StatusDisplay</td>
						<td><a asp-controller="product" asp-action="details" asp-route-id="@item.Id">Xem chi tiết</a></td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>
<a asp-controller="Home" asp-action="Index">Back</a>